# Weather Quant Bot — variáveis de ambiente
# Copie para .env e preencha os valores reais

# Telegram (obrigatório)
TELEGRAM_TOKEN=seu_token_aqui
CHAT_ID=seu_chat_id_aqui

# GitHub backup do bankroll (opcional mas recomendado)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO=seu_usuario/weather-quant-bot
GITHUB_BRANCH=main

# IA para análise via Telegram (opcional)
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Segunda fonte de forecast para consenso (opcional)
WEATHERAPI_KEY=sua_chave_aqui

# Railway injeta automaticamente
DATABASE_URL=postgres://...

# Controle de trading (0=observação, 1=trading real)
TRADING_ENABLED=0
