# Apenas variaveis que config.py realmente le.
# Removidas: MAX_DAILY_TRADES, MAX_WEEKLY_LOSS, MAX_DRAWDOWN_PCT e
# PAPER_EXECUTION_ENABLED — nenhuma existia no codigo.

# ── Credenciais ────────────────────────────────────────────────
TELEGRAM_TOKEN=seu_token_aqui
CHAT_ID=seu_chat_id_aqui
GROQ_API_KEY=gsk_xxxxxxxxxxxx
WEATHERAPI_KEY=sua_chave_weatherapi
# auto = tenta Postgres e cai para GitHub; github/free = usa GitHub como
# persistencia principal gratuita (bom quando o Postgres Free expirou).
PERSISTENCE_MODE=github
DATABASE_URL=postgres://...
# Fallback quando a Open-Meteo esgota tentativas (rate limit de IP
# compartilhado no Render). Rate limit do OpenWeatherMap e' por CHAVE,
# nao por IP. Gratis, sem cartao: https://openweathermap.org/api
OPENWEATHERMAP_KEY=

# ── Backup no GitHub ───────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO=seu_usuario/weather-quant-bot
# NUNCA usar a branch de deploy (main/master): cada backup dispara um
# redeploy e mata o processo no meio do ciclo. O codigo recusa main e cai
# para data-backup, mas configure certo aqui.
GITHUB_BRANCH=data-backup
APPLY_BANKROLL_OVERRIDE=0

# ── Modo de operacao ───────────────────────────────────────────
TRADING_ENABLED=0
# 1 = so registra trade se a compra passar pelo order book real da CLOB
PAPER_EXECUTION_REQUIRED=1
MIN_PRICE_YES_FOR_NO_RANGE2=0.20
CONSENSUS_MAX_RAW_DIFF=12.0
PAPER_MAX_SLIPPAGE=0.03
PAPER_MIN_FILL_RATIO=1.00
ORDERBOOK_TIMEOUT=8

# ── Risco ──────────────────────────────────────────────────────
MAX_POSITION=4.00
MAX_TOTAL_EXPOSURE=20.00
MAX_OPEN_TRADES=5
MAX_DAILY_LOSS=10.00
KELLY_FRACTION=0.50
MIN_TRADE_STAKE=1.00
MAX_FORECAST_DAY=3

# ── Filtros de mercado ─────────────────────────────────────────
MIN_MARKET_LIQUIDITY=100
MIN_MARKET_VOLUME=250
MAX_IMPLIED_SPREAD=0.08
MIN_PRICE=0.08
MAX_PRICE=0.88

# ── Modelo ─────────────────────────────────────────────────────
# 0 desliga o blend do ML. So subir depois de validacao out-of-sample.
ML_BLEND_WEIGHT=0.0
ML_MAX_DEVIATION=0.05
ML_MAX_RATIO=3.0
SIGMA_MIN=1.0
SIGMA_MAX=8.0
MAX_BUCKET_ZDIST=1.0

# ── Consenso multi-fonte ───────────────────────────────────────
# 1 = bloqueia entrada quando a 2a fonte nao confirma
REQUIRE_CONSENSUS=0
CONSENSUS_MAX_DIFF_RANGE2=1.5
CONSENSUS_MAX_DIFF_EXACT=1.5
CONSENSUS_MAX_DIFF_DEFAULT=2.5

# ── Analytics ──────────────────────────────────────────────────
HEALTH_MAX_AGE_HOURS=48
DECISION_LOG_FILE=decision_log.jsonl
LOG_LEVEL=INFO
